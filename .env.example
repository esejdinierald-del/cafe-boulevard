# ─────────────────────────────────────────────────────────────
# Frontend (Vite) — kopjo këtë file në `.env` dhe plotëso vlerat.
# NUK vë vlera reale sekrete këtu; përdor placeholders.
# Shih docs/ENV_TEMPLATE.md për shpjegim të plotë.
# ─────────────────────────────────────────────────────────────

# URL e projektit Supabase (https://<project-ref>.supabase.co)
VITE_SUPABASE_URL="your-project-url-here"

# Anon/publishable key — i sigurt për browser (RLS e mbron databazën)
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key-here"

# Ref-i i shkurtër i projektit (p.sh. abcxyz1234)
VITE_SUPABASE_PROJECT_ID="your-project-ref-here"

# ─────────────────────────────────────────────────────────────
# Edge Function Secrets NUK shkojnë këtu.
# Konfigurohen te Supabase Dashboard → Edge Functions → Secrets:
#   TELEGRAM_BOT_TOKEN, VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY,
#   CLEANUP_SECRET, INTERNAL_WEBHOOK_SECRET, FOOTBALL_DATA_API_KEY
# Shih docs/ENV_TEMPLATE.md.
# ─────────────────────────────────────────────────────────────
